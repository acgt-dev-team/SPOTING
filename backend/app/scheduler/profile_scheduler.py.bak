from apscheduler.schedulers.background import BackgroundScheduler
from sqlalchemy.orm import Session
from datetime import datetime

from app.database.session import SessionLocal
from app.models.profil import Profil
from app.models.x_profil_tugasan import XProfilTugasan
from app.services.tugasan_service import execute_scan
from app.services.agent_status_service import update_agent_status
from app.services.profile_agent_service import assign_agents_to_profile


scheduler = BackgroundScheduler(
    timezone="Asia/Kuala_Lumpur"
)

def schedule_profile_job(profile_id: int, scheduled_at):
    job_id = f"profile_{profile_id}"

    scheduler.add_job(
        run_single_profile,
        trigger="date",
        run_date=scheduled_at,
        args=[profile_id],
        id=job_id,
        replace_existing=True
    )

    print(
        f"[SCHEDULER] Profile {profile_id} "
        f"scheduled for {scheduled_at}"
    )

def remove_profile_job(profile_id: int):
    job_id = f"profile_{profile_id}"

    try:
        scheduler.remove_job(job_id)

        print(
            f"[SCHEDULER] Removed job for profile {profile_id}"
        )

    except Exception:
        # Job does not exist
        pass

# ==========================================
# Run single profile
# ==========================================
def run_single_profile(profile_id: int):
    db: Session = SessionLocal()
    profile = None

    try:
        profile = db.query(Profil).filter(
            Profil.id == profile_id
        ).first()

        if not profile:
            print(
                f"[SCHEDULER] Profile {profile_id} not found"
            )
            return

        print("\n========================================")
        print(f"[SCHEDULER] RUNNING PROFILE: {profile.nama}")
        print(f"[SCHEDULER] Profile ID: {profile.id}")
        print(f"[SCHEDULER] Scheduled at: {profile.scheduled_at}")
        print("========================================")

        # ------------------------------------------
        # Change scheduled profile into immediate
        # execution
        # ------------------------------------------

        profile.execution_type = "IMMEDIATE"
        profile.execution_status = "in process"

        db.commit()
        db.refresh(profile)

        print(
            "[SCHEDULER] Execution type changed to IMMEDIATE"
        )

        # ------------------------------------------
        # Ensure profile-agent assignments exist
        # ------------------------------------------

        assign_agents_to_profile(
            db=db,
            profile_id=profile.id
        )

        # ------------------------------------------
        # Load profile tasks
        # ------------------------------------------

        tasks = (
            db.query(XProfilTugasan)
            .filter(
                XProfilTugasan.profil_id == profile.id
            )
            .all()
        )

        if not tasks:
            print(
                f"[SCHEDULER] No tasks found for profile "
                f"{profile.id}"
            )

            profile.execution_status = "gagal"
            db.commit()
            return

        print(
            f"[SCHEDULER] Found {len(tasks)} task(s)"
        )

        # ------------------------------------------
        # Execute every task
        # ------------------------------------------

        all_success = True

        for task in tasks:

            print(
                f"[SCHEDULER] Executing task "
                f"{task.id}"
            )

            try:
                result = execute_scan(
                    db=db,
                    profil_tugasan_id=task.id,
                    penjadualan=False
                )

                print(
                    f"[SCHEDULER] Task {task.id} completed"
                )

                print(
                    f"[SCHEDULER] Result: {result}"
                )

            except Exception as task_error:

                all_success = False

                print(
                    f"[SCHEDULER] Task {task.id} failed: "
                    f"{task_error}"
                )

        # ------------------------------------------
        # Final profile status
        # ------------------------------------------

        if all_success:
            profile.execution_status = "execution completed"
        else:
            profile.execution_status = "gagal"

        db.commit()
        db.refresh(profile)

        print(
            f"[SCHEDULER] Profile {profile.id} "
            f"finished with status: "
            f"{profile.execution_status}"
        )

    except Exception as e:

        print(
            f"[SCHEDULER] Profile execution error: {e}"
        )

        if profile:
            profile.execution_status = "gagal"
            db.commit()

    finally:
        db.close()
      
def monitor_agents():
    db = SessionLocal()

    try:
        update_agent_status(db)

    except Exception as e:
        print(f"Agent monitor error: {e}")

    finally:
        db.close()


# ==========================================
# Load scheduled jobs
# ==========================================
def load_profile_jobs():
    db: Session = SessionLocal()
    scheduler.add_job(
        monitor_agents,
        trigger="interval",
        seconds=30,
        id="agent_monitor",
        replace_existing=True,
    )

    print("Agent monitor started.")
    try:
        profiles = db.query(Profil).filter(
            Profil.execution_type == "SCHEDULED",
            Profil.scheduled_at != None,
            Profil.execution_status == "telah dijadualkan"
        ).all()

        print(f"Found {len(profiles)} scheduled profiles")

        for profile in profiles:
            schedule_profile_job(
                profile_id=profile.id,
                scheduled_at=profile.scheduled_at
            )

            print(f"Scheduled profile {profile.nama} at {profile.scheduled_at}")

    except Exception as e:
        print(f"Scheduler load error: {str(e)}")

    finally:
        db.close()
        

